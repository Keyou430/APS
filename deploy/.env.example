COMPOSE_PROJECT_NAME=hermes-platform
APP_ENV=container

# Browser entry point. Use 0.0.0.0 to expose the platform on the local network.
APP_BIND=127.0.0.1
APP_PORT=8080

POSTGRES_DB=agent_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password

JWT_SECRET_KEY=change-this-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Move unfinished daily work items into the current weekly scope after local-day expiry.
WORK_ITEM_ARCHIVE_ENABLED=true
WORK_ITEM_ARCHIVE_POLL_SECONDS=60
WORK_ITEM_ARCHIVE_BATCH_SIZE=100

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@example.com
SINGLE_USER_MODE=true

# Local/CI stays FTS-only. Enable only with approved provider credentials.
RAG_EMBEDDING_ENABLED=false
RAG_EMBEDDING_API_URL=
RAG_EMBEDDING_API_KEY=

# Generated by the startup script for API -> private RAG worker authentication.
# This is not the embedding provider credential and must not be committed.
RAG_QUERY_EMBEDDING_TOKEN=
RAG_QUERY_AUDIT_HMAC_KEY=replace-with-random-api-only-secret
RAG_QUERY_AUDIT_HMAC_VERSION=1
FEATURE_EXTERNAL_GUESTS=false
GUEST_INVITATION_DELIVERY_ADAPTER=test
# Real guest trials use the smtp adapter. Keep credentials in deploy/.env only.
# GUEST_INVITATION_PUBLIC_BASE_URL=https://platform.example.com
# GUEST_INVITATION_RECIPIENT_ALLOWLIST=approved-recipient@example.com
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USERNAME=sender@example.com
# SMTP_PASSWORD=provider-authorization-code
# SMTP_FROM_EMAIL=sender@example.com
# SMTP_TIMEOUT_SECONDS=10

# Optional private Hermes container. The Hermes-enabled startup script generates
# HERMES_API_SERVER_KEY in deploy/.env; do not commit that runtime value.
HERMES_IMAGE=hermes-agent:v2026.7.7.2
HERMES_API_SERVER_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Shared only by the platform API and the private Hermes cron MCP/sidecar.
HERMES_CRON_INTERNAL_KEY=

# Single-host Ubuntu deployment. These endpoints stay private to the host and
# Docker bridge; never open RUNNER_CONTROL_PORT in the cloud security group.
RUNNER_HOST=host.docker.internal
RUNNER_CONTROL_PORT=9443
MEM0_API_URL=http://host.docker.internal:8888

# Optional Hermes Web provider credentials. Keep these empty here; inject exactly one
# approved provider through ignored deploy/.env before any live smoke test.
# TAVILY_API_KEY=
# EXA_API_KEY=
# PARALLEL_API_KEY=
# FIRECRAWL_API_KEY=
# SEARXNG_URL=

# Native DingTalk gateway. Leave CLIENT_ID/CLIENT_SECRET empty until the app is
# published. Secrets belong only in deploy/.env and must never be committed.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWED_USERS=
DINGTALK_ALLOWED_CHATS=
DINGTALK_REQUIRE_MENTION=true
DINGTALK_ALLOW_ALL_USERS=false
DINGTALK_HOME_CHANNEL=
DINGTALK_HOME_CHANNEL_NAME=星纪年AI工作平台
DINGTALK_WEBHOOK_URL=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_CODE=
# DingTalk staffId linked to the web demo account for read-only document access.
DINGTALK_DOC_OPERATOR_ID=
# Comma-separated HTTPS hosts observed and approved from provider fixtures; empty rejects downloads.
DINGTALK_ALLOWED_RESOURCE_HOSTS=

# Native Hermes Feishu/Lark gateway. WebSocket mode keeps the gateway private and
# requires no inbound webhook port. Keep APP_SECRET in ignored deploy/.env only.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_ALLOWED_USERS=
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOW_BOTS=none
FEISHU_REQUIRE_MENTION=true
FEISHU_GROUP_POLICY=allowlist
FEISHU_HOME_CHANNEL=
FEISHU_HOME_CHANNEL_NAME=星纪年AI工作平台
# Optional identity overrides; normally auto-detected from the Feishu app.
FEISHU_BOT_OPEN_ID=
FEISHU_BOT_USER_ID=
FEISHU_BOT_NAME=

# Platform-owned outbound decision delivery. The non-secret configured flag is
# exposed to the API for accurate delivery status without sharing credentials.
PLATFORM_FEISHU_APP_ID=
PLATFORM_FEISHU_APP_SECRET=
PLATFORM_FEISHU_DELIVERY_CONFIGURED=false
PLATFORM_FEISHU_READ_CONFIGURED=false
# API-side Feishu reader grants. Empty lists deny every resource.
PLATFORM_FEISHU_READ_ALLOWED_ORGANIZATION_IDS=
PLATFORM_FEISHU_READ_ALLOWED_DOCUMENT_TOKENS=
# Comma-separated organization_id:app_token:table_id grants; empty denies every Base table.
PLATFORM_FEISHU_READ_ALLOWED_BASE_TABLES=
PLATFORM_FEISHU_READ_ALLOWED_CHAT_IDS=
PLATFORM_PUBLIC_BASE_URL=

# Personal lark-cli OAuth state is not stored here. It lives in the dedicated
# lark_cli_data Docker volume and is changed with scripts/rebind-feishu.sh user.
