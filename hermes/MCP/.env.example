# Hermes MCP Server — Environment variable overrides
# Copy to .env and customize

# Server
# HERMES_MCP_SERVER_TRANSPORT=stdio
# HERMES_MCP_SERVER_HOST=127.0.0.1
# HERMES_MCP_SERVER_PORT=9200
# HERMES_MCP_SERVER_LOG_LEVEL=INFO

# Hermes backend
# HERMES_MCP_HERMES_MODE=auto
# HERMES_MCP_HERMES_EXE_PATH=D:\Replica1.0\hermes\hermes.exe

# Retrieval service
# HERMES_MCP_RETRIEVAL_BASE_URL=http://localhost:8001
# HERMES_MCP_RETRIEVAL_TIMEOUT=60.0
