APP_NAME=Hermes Enterprise Platform API
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_platform
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
HERMES_PROFILES_ROOT=./data/hermes-profiles
HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=runtime-only-private-key
HERMES_USE_HTTP=true
HERMES_HTTP_TIMEOUT_SECONDS=180
HERMES_HTTP_CONNECT_TIMEOUT_SECONDS=5
HERMES_HTTP_MAX_RETRIES=1
PIPELINE_APPROVAL_WORKER_POLL_SECONDS=30
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_PROVIDER=platform-disabled
MEMORY_EXTRACTION_PROVIDER_VERSION=v1
MEMORY_CAPTURE_TTL_HOURS=24
MEMORY_WORKER_POLL_SECONDS=1
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
SINGLE_USER_MODE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
